  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "/institutions-belges/" | abs,
  "url": "/institutions-belges/" | abs,
  "name": title,
  "description": description,
  "inLanguage": "fr-BE",
  "isPartOf": { "@id": site.url + "/#website" },
  "author": { "@id": site.url + "/#author" },
  "dateModified": institutions.checked,
  "about": [
    { "@type": "Country", "name": "Belgique", "sameAs": "https://www.wikidata.org/wiki/Q31" },
    { "@type": "Event", "name": "Élections législatives fédérales belges de 2024", "startDate": e.date, "location": { "@type": "Country", "name": "Belgique" }, "eventStatus": "https://schema.org/EventScheduled", "sameAs": "https://fr.wikipedia.org/wiki/%C3%89lections_l%C3%A9gislatives_f%C3%A9d%C3%A9rales_belges_de_2024" }
  ]
} | jsonld | safe }}</script>
